OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
REGISTRY_URL=http://localhost:10000

# Giới hạn token output (tiết kiệm credit). Để trống = 2048.
OPENROUTER_MAX_TOKENS=2048

# (Tùy chọn) Fallback sang Gemini trực tiếp (Google AI Studio) khi OpenRouter hết
# credit (402) hoặc rate limit (429). Lấy key miễn phí: https://aistudio.google.com/apikey
# Để trống = tắt fallback.
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
